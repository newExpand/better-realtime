{
  "schemaVersion": "1.0",
  "documentId": "https://better-realtime.dev/spec/protocol/v1/state-machines.json",
  "title": "Realtime Runtime Protocol 1.0 State Machines",
  "description": "Machine-readable normative transition inventory. A transition not listed for the current state is invalid unless the triggering record is explicitly classified as a duplicate and ignored.",
  "machines": {
    "connection": {
      "initial": "idle",
      "terminal": ["disposed"],
      "states": ["idle", "connecting", "open", "backing_off", "disposed"],
      "transitions": [
        { "from": "idle", "on": "connect.requested", "to": "connecting", "actions": ["allocate_connection_attempt_id", "open_transport"] },
        { "from": "connecting", "on": "transport.opened", "to": "open", "actions": ["start_session_open_deadline"] },
        { "from": "connecting", "on": "transport.failed", "to": "backing_off", "actions": ["record_transport_failure", "schedule_jittered_backoff"] },
        { "from": "open", "on": "transport.closed_unexpectedly", "to": "backing_off", "actions": ["suspend_session", "record_close_evidence", "schedule_jittered_backoff"] },
        { "from": "open", "on": "protocol.reconnect_required", "to": "backing_off", "actions": ["close_transport", "schedule_server_directed_backoff"] },
        { "from": "backing_off", "on": "backoff.elapsed", "to": "connecting", "actions": ["allocate_connection_attempt_id", "open_transport"] },
        { "from": "backing_off", "on": "network.online", "to": "connecting", "guards": ["retry_not_scheduled_sooner"], "actions": ["cancel_backoff", "allocate_connection_attempt_id", "open_transport"] },
        { "from": "idle", "on": "dispose", "to": "disposed", "actions": ["release_all_resources"] },
        { "from": "connecting", "on": "dispose", "to": "disposed", "actions": ["cancel_transport_open", "release_all_resources"] },
        { "from": "open", "on": "dispose", "to": "disposed", "actions": ["close_transport", "release_all_resources"] },
        { "from": "backing_off", "on": "dispose", "to": "disposed", "actions": ["cancel_backoff", "release_all_resources"] }
      ],
      "invariants": [
        "exactly_one_layer_owns_physical_reconnect",
        "at_most_one_transport_is_active_per_runtime",
        "every_attempt_has_a_unique_connection_attempt_id",
        "all_timers_and_transport_handles_are_released_on_dispose"
      ]
    },
    "session": {
      "initial": "absent",
      "terminal": ["disposed"],
      "states": ["absent", "opening", "ready", "reauthenticating", "suspended", "rejected", "disposed"],
      "transitions": [
        { "from": "absent", "on": "transport.opened", "to": "opening", "actions": ["send_session_open", "start_open_deadline"] },
        { "from": "opening", "on": "session.ready", "to": "ready", "guards": ["contract_digest_matches", "capability_floor_satisfied"], "actions": ["reset_backoff_after_stability_window", "store_rotated_resume_token", "start_application_heartbeat", "restore_declared_streams", "reconcile_pending_commands"] },
        { "from": "opening", "on": "session.rejected", "to": "rejected", "actions": ["apply_error_disposition", "close_transport"] },
        { "from": "opening", "on": "session.rejected.retry", "to": "suspended", "actions": ["apply_retry_disposition", "close_transport", "schedule_jittered_backoff"] },
        { "from": "ready", "on": "session.rejected", "to": "rejected", "actions": ["apply_error_disposition", "close_transport"] },
        { "from": "ready", "on": "session.rejected.retry", "to": "suspended", "actions": ["pause_delivery", "apply_retry_disposition", "close_transport", "schedule_jittered_backoff"] },
        { "from": "reauthenticating", "on": "session.rejected", "to": "rejected", "actions": ["apply_error_disposition", "close_transport"] },
        { "from": "reauthenticating", "on": "session.rejected.retry", "to": "suspended", "actions": ["pause_delivery", "apply_retry_disposition", "close_transport", "schedule_jittered_backoff"] },
        { "from": "opening", "on": "open_deadline.elapsed", "to": "rejected", "actions": ["emit_init_timeout", "close_transport"] },
        { "from": "opening", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["cancel_open_deadline", "discard_partial_session_initialization", "preserve_bounded_recovery_state"] },
        { "from": "ready", "on": "session.auth.challenge", "to": "reauthenticating", "actions": ["pause_new_operations", "invoke_single_flight_credential_provider"] },
        { "from": "reauthenticating", "on": "credentials.available", "to": "reauthenticating", "actions": ["send_session_auth_update"] },
        { "from": "reauthenticating", "on": "session.auth.updated", "to": "ready", "actions": ["reauthorize_active_streams", "release_paused_operations"] },
        { "from": "reauthenticating", "on": "auth_refresh.failed", "to": "rejected", "actions": ["fail_paused_operations", "close_transport"] },
        { "from": "ready", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["pause_delivery", "preserve_bounded_recovery_state"] },
        { "from": "reauthenticating", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["pause_delivery", "preserve_bounded_recovery_state"] },
        { "from": "suspended", "on": "transport.opened", "to": "opening", "actions": ["send_session_open_with_fresh_auth_and_optional_resume", "start_open_deadline"] },
        { "from": "rejected", "on": "retry_authorized", "to": "absent", "actions": ["clear_rejection"] },
        { "from": "absent", "on": "dispose", "to": "disposed", "actions": ["release_session_resources"] },
        { "from": "opening", "on": "dispose", "to": "disposed", "actions": ["cancel_open_deadline", "release_session_resources"] },
        { "from": "ready", "on": "dispose", "to": "disposed", "actions": ["stop_heartbeat", "release_session_resources"] },
        { "from": "reauthenticating", "on": "dispose", "to": "disposed", "actions": ["cancel_auth_refresh", "stop_heartbeat", "release_session_resources"] },
        { "from": "suspended", "on": "dispose", "to": "disposed", "actions": ["release_recovery_state", "release_session_resources"] },
        { "from": "rejected", "on": "dispose", "to": "disposed", "actions": ["release_session_resources"] }
      ],
      "invariants": [
        "session_open_is_the_first_application_message_and_is_sent_once_per_transport",
        "every_physical_reconnect_reauthenticates",
        "a_resume_token_never_substitutes_for_authentication",
        "session_generation_increases_for_each_accepted_physical_connection",
        "new_commands_and_subscriptions_do_not_cross_an_unresolved_auth_challenge",
        "heartbeat_remains_active_while_credentials_are_refreshing"
      ]
    },
    "stream": {
      "initial": "idle",
      "terminal": ["closed"],
      "states": ["idle", "subscribing", "replaying", "resyncing", "live", "suspended", "failed", "closed"],
      "transitions": [
        { "from": "idle", "on": "subscribe.requested", "to": "subscribing", "actions": ["allocate_request_id", "send_stream_subscribe"] },
        { "from": "subscribing", "on": "stream.subscribed.live", "to": "live", "actions": ["store_subscription_and_head"] },
        { "from": "subscribing", "on": "stream.subscribed.replay", "to": "replaying", "actions": ["store_subscription_and_head", "open_bounded_live_buffer"] },
        { "from": "subscribing", "on": "stream.subscribed.snapshot", "to": "resyncing", "actions": ["store_subscription_and_head", "open_bounded_live_buffer"] },
        { "from": "replaying", "on": "stream.replay.begin", "to": "replaying", "actions": ["store_replay_id_and_declared_head"] },
        { "from": "resyncing", "on": "stream.resync.required", "to": "resyncing", "actions": ["store_resync_id_and_reason"] },
        { "from": "replaying", "on": "event.replay", "to": "replaying", "guards": ["event_identity_valid", "sequence_contiguous_or_duplicate"], "actions": ["dedupe_and_apply", "advance_cursor"] },
        { "from": "replaying", "on": "event.live", "to": "replaying", "actions": ["buffer_with_count_and_byte_bounds"] },
        { "from": "replaying", "on": "stream.replay.complete", "to": "live", "guards": ["cursor_reaches_declared_through", "buffer_is_contiguous"], "actions": ["release_buffer_in_order"] },
        { "from": "replaying", "on": "gap.detected", "to": "resyncing", "actions": ["request_fenced_resync"] },
        { "from": "replaying", "on": "recovery.requested", "to": "subscribing", "actions": ["replace_subscription_generation", "send_stream_subscribe_after_last_applied_cursor"] },
        { "from": "resyncing", "on": "stream.snapshot", "to": "resyncing", "guards": ["snapshot_cursor_is_atomically_consistent_with_state"], "actions": ["replace_materialized_state", "set_snapshot_cursor"] },
        { "from": "resyncing", "on": "event.snapshot_catchup", "to": "resyncing", "guards": ["event_is_after_snapshot_cursor", "sequence_contiguous_or_duplicate"], "actions": ["dedupe_and_apply", "advance_cursor"] },
        { "from": "resyncing", "on": "event.live", "to": "resyncing", "actions": ["buffer_with_count_and_byte_bounds"] },
        { "from": "resyncing", "on": "stream.replay.complete", "to": "live", "guards": ["cursor_reaches_declared_through", "buffer_is_contiguous"], "actions": ["release_buffer_in_order"] },
        { "from": "replaying", "on": "recovery_buffer.overflow", "to": "resyncing", "actions": ["discard_partial_recovery", "emit_recovery_overflow", "restart_fenced_snapshot"] },
        { "from": "resyncing", "on": "recovery_buffer.overflow", "to": "resyncing", "actions": ["discard_partial_recovery", "emit_recovery_overflow", "restart_fenced_snapshot"] },
        { "from": "resyncing", "on": "recovery.requested", "to": "subscribing", "actions": ["replace_subscription_generation", "send_stream_subscribe_for_fenced_snapshot"] },
        { "from": "live", "on": "event.live", "to": "live", "guards": ["event_identity_valid", "sequence_contiguous_or_duplicate"], "actions": ["dedupe_and_apply", "advance_cursor"] },
        { "from": "live", "on": "gap.detected", "to": "replaying", "actions": ["request_replay_after_last_applied_cursor", "open_bounded_live_buffer"] },
        { "from": "subscribing", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["preserve_last_applied_cursor"] },
        { "from": "replaying", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["discard_delivery_attempt_state", "preserve_last_applied_cursor"] },
        { "from": "resyncing", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["discard_delivery_attempt_state", "preserve_last_applied_cursor"] },
        { "from": "live", "on": "transport.closed_unexpectedly", "to": "suspended", "actions": ["preserve_last_applied_cursor"] },
        { "from": "suspended", "on": "session.ready", "to": "subscribing", "actions": ["send_stream_subscribe_after_last_applied_cursor"] },
        { "from": "subscribing", "on": "operation.error.fail", "to": "failed", "actions": ["record_terminal_stream_error"] },
        { "from": "replaying", "on": "operation.error.fail", "to": "failed", "actions": ["record_terminal_stream_error"] },
        { "from": "resyncing", "on": "operation.error.fail", "to": "failed", "actions": ["record_terminal_stream_error"] },
        { "from": "live", "on": "operation.error.fail", "to": "failed", "actions": ["record_terminal_stream_error"] },
        { "from": "idle", "on": "unsubscribe", "to": "closed", "actions": ["release_stream_resources"] },
        { "from": "subscribing", "on": "unsubscribe", "to": "closed", "actions": ["send_or_queue_unsubscribe", "release_stream_resources"] },
        { "from": "replaying", "on": "unsubscribe", "to": "closed", "actions": ["send_or_queue_unsubscribe", "release_stream_resources"] },
        { "from": "resyncing", "on": "unsubscribe", "to": "closed", "actions": ["send_or_queue_unsubscribe", "release_stream_resources"] },
        { "from": "live", "on": "unsubscribe", "to": "closed", "actions": ["send_stream_unsubscribe", "release_stream_resources"] },
        { "from": "suspended", "on": "unsubscribe", "to": "closed", "actions": ["release_stream_resources"] },
        { "from": "failed", "on": "unsubscribe", "to": "closed", "actions": ["release_stream_resources"] }
      ],
      "invariants": [
        "only_stable_event_id_controls_deduplication",
        "delivery_id_identifies_an_attempt_and_never_controls_domain_deduplication",
        "last_applied_cursor_advances_only_after_successful_application",
        "live_events_are_not_released_before_the_declared_replay_or_snapshot_fence",
        "recovery_buffers_are_bounded_by_records_and_bytes",
        "overflow_is_explicit_and_never_silently_drops_events"
      ]
    },
    "command": {
      "initial": "created",
      "terminal": ["observed", "rejected", "expired", "unknown", "cancelled"],
      "states": ["created", "queued", "sent", "accepted", "completed", "observed", "reconciling", "rejected", "expired", "unknown", "cancelled"],
      "transitions": [
        { "from": "created", "on": "execute", "to": "queued", "actions": ["allocate_stable_command_id", "persist_bounded_pending_record"] },
        { "from": "queued", "on": "session.ready", "to": "sent", "actions": ["allocate_command_attempt_id", "send_command"] },
        { "from": "sent", "on": "command.receipt.accepted", "to": "accepted", "actions": ["record_durable_acceptance"] },
        { "from": "sent", "on": "command.receipt.rejected", "to": "rejected", "actions": ["settle_with_error"] },
        { "from": "sent", "on": "transport.closed_before_receipt", "to": "reconciling", "actions": ["preserve_stable_command_id", "discard_attempt_id"] },
        { "from": "accepted", "on": "command.completed", "to": "completed", "actions": ["settle_completed_promise", "record_causal_event_ids"] },
        { "from": "sent", "on": "command.completed", "to": "completed", "guards": ["command_receipts_not_negotiated"], "actions": ["settle_completed_promise", "record_causal_event_ids"] },
        { "from": "sent", "on": "command.result.invalid", "to": "rejected", "actions": ["settle_with_contract_error", "record_contract_mismatch"] },
        { "from": "accepted", "on": "command.result.invalid", "to": "rejected", "actions": ["settle_with_contract_error", "record_contract_mismatch"] },
        { "from": "accepted", "on": "event_free_completion.satisfied", "to": "observed", "actions": ["settle_completed_and_observed_promises"] },
        { "from": "accepted", "on": "causal_events.applied", "to": "observed", "actions": ["settle_completed_and_observed_promises"] },
        { "from": "completed", "on": "causal_events.applied", "to": "observed", "actions": ["settle_observed_promise"] },
        { "from": "completed", "on": "event_free_completion.satisfied", "to": "observed", "actions": ["settle_observed_promise"] },
        { "from": "accepted", "on": "transport.closed", "to": "reconciling", "actions": ["preserve_stable_command_id"] },
        { "from": "completed", "on": "transport.closed_before_observed", "to": "reconciling", "actions": ["preserve_result_and_stable_command_id"] },
        { "from": "reconciling", "on": "session.ready", "to": "reconciling", "actions": ["send_command_status_request"] },
        { "from": "reconciling", "on": "command.status.accepted", "to": "accepted", "actions": ["record_durable_acceptance"] },
        { "from": "reconciling", "on": "command.status.completed", "to": "completed", "actions": ["settle_completed_promise", "record_causal_event_ids"] },
        { "from": "reconciling", "on": "command.result.invalid", "to": "rejected", "actions": ["settle_with_contract_error", "record_contract_mismatch"] },
        { "from": "reconciling", "on": "command.status.rejected", "to": "rejected", "actions": ["settle_with_error"] },
        { "from": "reconciling", "on": "command.status.expired", "to": "expired", "actions": ["settle_as_retention_expired"] },
        { "from": "reconciling", "on": "command.status.unknown", "to": "unknown", "actions": ["settle_without_guessing_outcome"] },
        { "from": "reconciling", "on": "retry.allowed", "to": "sent", "guards": ["idempotency_retention_still_valid"], "actions": ["allocate_command_attempt_id", "resend_with_same_command_id"] },
        { "from": "created", "on": "cancel", "to": "cancelled", "actions": ["release_pending_record"] },
        { "from": "queued", "on": "cancel", "to": "cancelled", "actions": ["release_pending_record"] },
        { "from": "created", "on": "dispose", "to": "cancelled", "actions": ["settle_pending_promises", "release_pending_record"] },
        { "from": "queued", "on": "dispose", "to": "cancelled", "actions": ["settle_pending_promises", "release_pending_record"] },
        { "from": "sent", "on": "dispose", "to": "cancelled", "actions": ["settle_pending_promises", "release_pending_record"] },
        { "from": "accepted", "on": "dispose", "to": "cancelled", "actions": ["settle_pending_promises", "release_pending_record"] },
        { "from": "completed", "on": "dispose", "to": "cancelled", "actions": ["settle_pending_promises", "release_pending_record"] },
        { "from": "reconciling", "on": "dispose", "to": "cancelled", "actions": ["settle_pending_promises", "release_pending_record"] }
      ],
      "invariants": [
        "one_execute_call_creates_one_new_command_id",
        "a_retry_of_the_same_logical_command_reuses_its_command_id",
        "each_wire_attempt_has_a_new_command_attempt_id",
        "transport_retry_never_implies_safe_domain_retry_without_idempotency_retention",
        "command_result_retention_is_positive_and_not_greater_than_idempotency_retention",
        "same_command_and_canonical_intent_has_one_effect_within_idempotency_retention",
        "different_canonical_intent_for_the_same_command_is_rejected",
        "a_client_never_resends_after_idempotency_retention",
        "completed_and_observed_are_distinct_settlement_boundaries",
        "an_unknown_outcome_is_reported_as_unknown_and_never_guessed"
      ]
    },
    "transaction_outcome": {
      "initial": "pre_commit",
      "terminal": ["committed", "rolled_back", "reconciled"],
      "states": ["pre_commit", "commit_in_flight", "committed", "rolled_back", "indeterminate", "reconciling", "reconciled"],
      "transitions": [
        { "from": "pre_commit", "on": "commit.invoked", "to": "commit_in_flight", "actions": ["record_commit_invocation"] },
        { "from": "pre_commit", "on": "pre_commit.failed", "to": "rolled_back", "guards": ["commit_not_invoked"], "actions": ["record_pre_commit_rollback"] },
        { "from": "commit_in_flight", "on": "commit.acknowledged", "to": "committed", "actions": ["record_commit_acknowledgement"] },
        { "from": "commit_in_flight", "on": "commit.abort_proven", "to": "rolled_back", "guards": ["authoritative_postgres_error_response_proves_abort"], "actions": ["record_authoritative_abort"] },
        { "from": "commit_in_flight", "on": "commit.ack_unavailable", "to": "indeterminate", "actions": ["record_unknown_outcome", "prohibit_success_claim"] },
        { "from": "indeterminate", "on": "reconciliation.started", "to": "reconciling", "actions": ["serialize_with_original_operation_namespace"] },
        { "from": "reconciling", "on": "durable_state.committed", "to": "reconciled", "actions": ["record_committed_resolution_and_proof"] },
        { "from": "reconciling", "on": "durable_state.absent", "to": "reconciled", "actions": ["record_rolled_back_resolution_and_proof"] },
        { "from": "reconciling", "on": "read_only.retry_succeeded", "to": "reconciled", "actions": ["record_no_durable_effect_resolution"] },
        { "from": "reconciling", "on": "reconciliation.unresolved", "to": "indeterminate", "actions": ["retain_unknown_outcome", "prohibit_success_claim"] }
      ],
      "invariants": [
        "an_error_after_commit_invocation_is_indeterminate_without_authoritative_abort_evidence",
        "same_connection_rollback_is_cleanup_evidence_and_never_commit_outcome_proof",
        "original_commit_acknowledgement_and_reconciliation_proof_have_distinct_provenance",
        "reconciliation_uses_the_same_transaction_and_operation_scope_as_the_indeterminate_attempt",
        "only_the_exact_durable_transaction_attempt_marker_or_a_successful_read_only_discard_and_retry_resolves_indeterminate",
        "a_competing_retry_never_proves_the_original_transaction_outcome",
        "reconciliation_deadline_bounds_cleanup_connection_acquisition_lock_wait_and_inspection",
        "unresolved_indeterminate_prevents_a_proven_doctor_verdict"
      ]
    },
    "resource_scope": {
      "initial": "active",
      "terminal": ["disposed"],
      "states": ["active", "disposing", "disposed"],
      "transitions": [
        { "from": "active", "on": "dispose", "to": "disposing", "actions": ["reject_new_acquisitions", "dispose_children_reverse_order"] },
        { "from": "disposing", "on": "children_released", "to": "disposed", "actions": ["assert_resource_baseline"] },
        { "from": "disposing", "on": "child_release_failed", "to": "disposing", "actions": ["record_cleanup_failure", "continue_remaining_cleanup"] }
      ],
      "invariants": [
        "every_acquired_resource_has_exactly_one_owner",
        "dispose_is_idempotent",
        "failed_partial_initialization_runs_the_same_cleanup_path",
        "resource_counts_plateau_after_repeated_lifecycle_churn"
      ]
    }
  }
}
