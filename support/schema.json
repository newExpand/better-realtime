{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-realtime.dev/support/schema.json",
  "type": "object",
  "required": ["schemaVersion", "releaseLine", "releaseVersion", "packageName", "webSocketSubprotocol", "features"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "releaseLine": { "type": "string", "pattern": "^0\\.[0-9]+\\.x-alpha$" },
    "releaseVersion": { "type": "string", "pattern": "^0\\.[0-9]+\\.0-alpha\\.[1-9][0-9]*$" },
    "packageName": { "const": "better-realtime" },
    "webSocketSubprotocol": { "const": "better-realtime.v1" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "protocolStatus", "runtimeStatus", "roadmapStatus", "verifiedEnvironments", "protocolEvidence", "runtimeEvidence", "verificationEvidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "protocolStatus": { "enum": ["defined", "not-applicable", "not-defined"] },
          "runtimeStatus": { "enum": ["implemented", "unsupported", "internal-fixture", "not-implemented"] },
          "roadmapStatus": { "enum": ["current-alpha", "committed-post-alpha", "demand-gated-candidate", "not-planned"] },
          "verifiedEnvironments": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "protocolEvidence": { "type": "array", "items": { "type": "string", "pattern": "^(spec|conformance)/" }, "uniqueItems": true },
          "runtimeEvidence": { "type": "array", "items": { "type": "string", "pattern": "^(packages|fixtures)/.+/src/" }, "uniqueItems": true },
          "verificationEvidence": { "type": "array", "items": { "type": "string", "pattern": "^(packages/.+/test/|tests/|scripts/|conformance/)" }, "uniqueItems": true }
        }
      }
    }
  }
}
