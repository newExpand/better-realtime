{
  "name": "better-realtime-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm protocol:check && pnpm support:check && pnpm release:check && pnpm typecheck && pnpm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run packages/store-postgres/test/postgres.integration.test.ts",
    "test:postgres:docker": "bash scripts/test-postgres-docker.sh",
    "protocol:check": "tsx scripts/check-protocol.ts",
    "support:check": "tsx scripts/check-support.ts",
    "support:render": "tsx scripts/check-support.ts --write",
    "release:check": "tsx scripts/check-release-security.ts",
    "release:check-public-history": "tsx scripts/check-public-history.ts",
    "release:verify-public-tree": "tsx scripts/verify-public-tree.ts",
    "doctor": "tsx scripts/doctor-demo.ts",
    "benchmark:plateau": "node --expose-gc --import tsx scripts/plateau.ts",
    "benchmark:multi-gateway": "pnpm --filter @realtime/server-node benchmark:multi-gateway",
    "benchmark:diagnostics": "tsx scripts/diagnostic-overhead.ts",
    "dev": "pnpm --parallel --filter @realtime/recovery-demo --filter @realtime/server-node dev",
    "dev:server": "pnpm --filter @realtime/server-node dev",
    "dev:demo": "pnpm --filter @realtime/recovery-demo dev",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "package:pack": "tsx scripts/pack-runtime.ts",
    "package:clean-room": "tsx scripts/verify-clean-room.ts",
    "package:export-public": "tsx scripts/export-public.ts",
    "e2e:consumer": "tsx scripts/verify-consumer-journey.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "ws": "8.21.1"
  }
}
